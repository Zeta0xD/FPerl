<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">

	<Script file="FPerl_AssistFrame.lua"/>

	<Frame name="FPerl_ListTemplate" inherits="FPerl_BackdropTemplate" virtual="true">
		<Layers>
			<Layer level="ARTWORK">
				<FontString name="$parentText" inherits="GameFontNormalSmall" justifyH="LEFT" justifyV="TOP">
					<Anchors>
						<Anchor point="TOPLEFT"/>
						<Anchor point="BOTTOMRIGHT"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
	</Frame>

	<Frame name="FPerl_Assists_FrameAnchor" movable="true" resizable="true" parent="UIParent" inherits="FPerl_BackdropTemplate" clampedToScreen="true">
		<Size>
			<AbsDimension x="330" y="124"/>
		</Size>
	</Frame>

	<Frame name="FPerl_Assists_Frame" frameStrata="LOW" resizable="true" parent="FPerl_Assists_FrameAnchor" inherits="FPerl_BackdropTemplate" hidden="true" enableMouse="true" clampedToScreen="true">
		<KeyValues>
			<KeyValue key="backdropInfo" value="FPerl_Raid_Backdrop_32_16_3333" type="global"/>
		</KeyValues>
		<Size>
			<AbsDimension x="330" y="124"/>
		</Size>
		<Anchors>
			<Anchor point="TOPLEFT"/>
		</Anchors>
		<Frames>
			<Button name="FPerl_AssistsCloseButton" inherits="UIPanelCloseButton">
				<Size>
					<AbsDimension x="20" y="20"/>
				</Size>
				<Anchors>
					<Anchor point="TOPRIGHT"/>
				</Anchors>
				<Scripts>
					<OnClick>
						FPerl.RaidHelper.AssistsViewClose()
					</OnClick>
				</Scripts>
			</Button>

			<Button name="FPerl_AssistPin" inherits="FPerl_BasicButton">
				<Size>
					<AbsDimension x="11" y="11"/>
				</Size>
				<Anchors>
					<Anchor point="RIGHT" relativeTo="FPerl_AssistsCloseButton" relativePoint="LEFT">
						<Offset>
							<AbsDimension x="4" y="0"/>
						</Offset>
					</Anchor>
				</Anchors>
				<NormalTexture file="Interface\Addons\FPerl_RaidHelper\Images\FPerl_Pin">
					<TexCoords left="0" right="0.46875" top="0" bottom="0.453125"/>
				</NormalTexture>
				<PushedTexture file="Interface\Addons\FPerl_RaidHelper\Images\FPerl_Pin">
					<TexCoords left="0" right="0.46875" top="0.5" bottom="0.953125"/>
				</PushedTexture>
				<HighlightTexture file="Interface\Buttons\UI-Panel-MinimizeButton-Highlight" alphaMode="ADD">
					<TexCoords left="0" right="0.9" top="0.1" bottom="0.9"/>
				</HighlightTexture>
				<Scripts>
					<OnLoad>
						self.SetButtonTex = function()
							local tex = FPerl_AssistPin:GetNormalTexture()
							if (FPerlRaidHelperDB and FPerlRaidHelperDB.AssistPinned) then
								tex:SetTexCoord(0.5, 0.96875, 0, 0.453125)
							else
								tex:SetTexCoord(0, 0.46875, 0, 0.453125)
							end

							tex = FPerl_AssistPin:GetPushedTexture()
							if (FPerlRaidHelperDB and FPerlRaidHelperDB.AssistPinned) then
								if (FPerl_Assists_Frame.corner) then
									FPerl_Assists_Frame.corner:Hide()
								end
								tex:SetTexCoord(0.5, 0.96875, 0.5, 0.953125)
							else
								if (FPerl_Assists_Frame.corner) then
									FPerl_Assists_Frame.corner:Show()
								end
								tex:SetTexCoord(0, 0.46875, 0.5, 0.953125)
							end
						end
						self.tooltipText = FPERL_BUTTON_HELPER_PIN
					</OnLoad>
					<OnClick>
						FPerlRaidHelperDB.AssistPinned = not FPerlRaidHelperDB.AssistPinned
						self:SetButtonTex()
					</OnClick>
				</Scripts>
			</Button>

			<ScrollFrame name="FPerl_Target_Targetting_ScrollFrame">
				<Anchors>
					<Anchor point="TOPLEFT">
						<Offset>
							<AbsDimension x="4" y="-5"/>
						</Offset>
					</Anchor>
					<Anchor point="BOTTOMRIGHT" relativePoint="BOTTOM">
						<Offset>
							<AbsDimension x="-1" y="4"/>
						</Offset>
					</Anchor>
				</Anchors>
				<ScrollChild>
					<Frame name="FPerl_Target_Assists_ScrollChild_Targetting" inherits="FPerl_ListTemplate">
						<Size>
							<AbsDimension x="300" y="400"/>
						</Size>
					</Frame>
				</ScrollChild>
				<Scripts>
					<OnMouseDown>
						FPerl.RaidHelper.AssistsMouseDown(FPerl_Assists_Frame, button, "targetFrame")
					</OnMouseDown>
					<OnMouseUp>
						FPerl.RaidHelper.AssistsMouseUp(FPerl_Assists_Frame, button, "targetFrame")
					</OnMouseUp>
					<OnSizeChanged>
						FPerl_Target_Assists_ScrollChild_Targetting:SetWidth(FPerl_Target_Targetting_ScrollFrame:GetWidth() / FPerl_Target_Targetting_ScrollFrame:GetEffectiveScale())
					</OnSizeChanged>
				</Scripts>
			</ScrollFrame>
			<ScrollFrame name="FPerl_Target_Assists_ScrollFrame">
				<Anchors>
					<Anchor point="TOPLEFT" relativePoint="TOP">
						<Offset>
							<AbsDimension x="0" y="-5"/>
						</Offset>
					</Anchor>
					<Anchor point="BOTTOMRIGHT">
						<Offset>
							<AbsDimension x="-4" y="4"/>
						</Offset>
					</Anchor>
				</Anchors>
				<ScrollChild>
					<Frame name="FPerl_Target_Assists_ScrollChild_Assists" inherits="FPerl_ListTemplate">
						<Size>
							<AbsDimension x="300" y="400"/>
						</Size>
					</Frame>
				</ScrollChild>
				<Scripts>
					<OnSizeChanged>
						FPerl_Target_Assists_ScrollChild_Assists:SetWidth(FPerl_Target_Assists_ScrollFrame:GetWidth() / FPerl_Target_Assists_ScrollFrame:GetEffectiveScale())
					</OnSizeChanged>
					<OnMouseDown>
						FPerl.RaidHelper.AssistsMouseDown(FPerl_Assists_Frame, button)
					</OnMouseDown>
					<OnMouseUp>
						FPerl.RaidHelper.AssistsMouseUp(FPerl_Assists_Frame, button)
					</OnMouseUp>
				</Scripts>
			</ScrollFrame>

			<Frame name="FPerl_ScrollSeperator">
				<Anchors>
					<Anchor point="TOPLEFT" relativePoint="TOPRIGHT" relativeTo="FPerl_Target_Targetting_ScrollFrame"/>
					<Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMLEFT" relativeTo="FPerl_Target_Assists_ScrollFrame"/>
				</Anchors>
				<Layers>
					<Layer level="ARTWORK">
						<Texture file="Interface\AddOns\FPerl_RaidHelper\Images\FPerl_FrameBack" setAllPoints="true"/>
					</Layer>
				</Layers>
			</Frame>
		</Frames>
		<Scripts>
			<OnLoad>
				self:OnBackdropLoaded()
				FPerl.RaidHelper.AssistsOnLoad(self)
			</OnLoad>
		</Scripts>
	</Frame>

	<Frame>
		<Scripts>
			<OnLoad>
				self:SetScript("OnUpdate", FPerl.RaidHelper.AssistsOnUpdate)
			</OnLoad>
		</Scripts>
	</Frame>

	<!-- These two frames add to X-Perl UnitFrames. If X-Perl not loaded, then WoW will just ignore these without error -->
	<Button name="FPerl_Player_TargettingFrame" inherits="FPerl_BackdropTemplate" enableMouse="true" text="0" hidden="true">
		<KeyValues>
			<KeyValue key="backdropInfo" value="FPerl_Frame_Backdrop_32_16_3333" type="global"/>
		</KeyValues>
		<Size>
			<AbsDimension x="27" y="20"/>
		</Size>
		<NormalFont style="GameFontNormalSmall"/>
		<ButtonText name="$parenttext" setAllPoints="true"/>
		<HighlightTexture file="Interface\Addons\FPerl\Images\FPerl_Highlight" alphaMode="ADD">
			<TexCoords left="0" right="0.25" top="0" bottom="0.5"/>
		</HighlightTexture>
		<!--<Anchors>
			<Anchor point="TOPRIGHT" relativePoint="TOPLEFT" relativeTo="FPerl_PlayerportraitFrame">
				<Offset>
					<AbsDimension x="2" y="-19"/>
				</Offset>
			</Anchor>
		</Anchors>-->
		<Scripts>
			<OnLoad>
				self:OnBackdropLoaded()
				if FPerl_Player then
					self:SetParent(FPerl_Player)
					self:SetPoint("TOPRIGHT", FPerl_PlayerportraitFrame, "TOPLEFT", 2, -19)
				end
				if (FPerl.RegisterUnitText) then
					FPerl.RegisterUnitText(self)
				end
			</OnLoad>
			<OnClick>
				FPerl.RaidHelper.ToggleAssistsFrame("targetting")
				FPerl.RaidHelper.SetFrameSides()
				FPerl.RaidHelper.ShowAssists()
			</OnClick>
			<OnEnter>
				local title
				if (table.getn(FPerl_Assists_Frame.targetting) > 0 and FPerl_Assists_Frame.targetting[1][2] == "") then
					title = FPERL_TOOLTIP_ENEMYONME
				else
					if (FPerlRaidHelperDB.TargetCountersSelf == 0) then
						title = FPERL_TOOLTIP_ALLONME
					else
						title = FPERL_TOOLTIP_HEALERS
					end
				end

				local t = FPerl.RaidHelper.MakeAssistsString(FPerl_Assists_Frame.targetting, title)
				t = "|c00FFFFFF"..t.."\r|c009F6000"..FPERL_TOOLTIP_HELP
				GameTooltip:SetOwner(self, "ANCHOR_BOTTOMRIGHT")
				GameTooltip:SetText(t)
				GameTooltip:Show()
			</OnEnter>
			<OnLeave>
				FPerl.PlayerTipHide()
			</OnLeave>
		</Scripts>
	</Button>

	<Button name="FPerl_Target_AssistFrame" inherits="FPerl_BackdropTemplate" hidden="true">
		<KeyValues>
			<KeyValue key="backdropInfo" value="FPerl_Frame_Backdrop_32_16_3333" type="global"/>
		</KeyValues>
		<Size>
			<AbsDimension x="27" y="20"/>
		</Size>
		<NormalFont style="GameFontNormalSmall"/>
		<ButtonText name="$parenttext" setAllPoints="true"/>
		<HighlightTexture file="Interface\Addons\FPerl\Images\FPerl_Highlight" alphaMode="ADD">
			<TexCoords left="0" right="0.25" top="0" bottom="0.5"/>
		</HighlightTexture>
		<Anchors>
			<Anchor point="TOPLEFT">
				<Offset>
					<AbsDimension x="-2" y="-20"/>
				</Offset>
			</Anchor>
		</Anchors>
		<Scripts>
			<OnLoad>
				self:OnBackdropLoaded()
				if (FPerl_Target) then
					self:SetParent(FPerl_Target)
					self:ClearAllPoints()
					self:SetPoint("TOPLEFT", FPerl_Target.portraitFrame, "TOPRIGHT", -2, -20)
					self:Raise()
				end
				if (FPerl.RegisterUnitText) then
					FPerl.RegisterUnitText(self)
				end
			</OnLoad>
			<OnClick>
				FPerl.RaidHelper.ToggleAssistsFrame("assists")
				FPerl.RaidHelper.SetFrameSides()
				FPerl.RaidHelper.ShowAssists()
			</OnClick>
			<OnEnter>
				local t = FPerl.RaidHelper.MakeAssistsString(FPerl_Assists_Frame.assists, FPERL_TOOLTIP_ASSISTING)
				t = "|c00FFFFFF"..t.."\r|c009F6000"..FPERL_TOOLTIP_HELP
				GameTooltip:SetOwner(self, "ANCHOR_BOTTOMRIGHT")
				GameTooltip:SetText(t)
				GameTooltip:Show()
			</OnEnter>
			<OnLeave>
				FPerl.PlayerTipHide()
			</OnLeave>
		</Scripts>
	</Button>

	<Frame name="FPerl_AggroAnchor" frameStrata="HIGH" parent="UIParent" inherits="FPerl_BackdropTemplate" movable="true">
		<Size>
			<AbsDimension x="32" y="32"/>
		</Size>
		<Frames>
			<Frame name="$parentArrows" inherits="FPerl_BackdropTemplate" setAllPoints="true">
				<Layers>
					<Layer level="ARTWORK">
						<Texture name="$parenttex" file="Interface\Addons\FPerl_RaidHelper\Images\FPerl_MoveCursor" setAllPoints="true"/>
					</Layer>
				</Layers>
				<Scripts>
					<OnLoad>
						self:RegisterForDrag("LeftButton")
					</OnLoad>
					<OnHide>
						FPerl_AggroAnchor:StopMovingOrSizing()
						if (FPerl_Aggro) then
							FPerl_Aggro:SetScript("OnUpdate", FPerl.RaidHelper.RefreshAggro)
							FPerl_AggroPlayer:Hide()
							FPerl_AggroPet:Hide()
							FPerl_Aggro:Hide()
						end
					</OnHide>
					<OnEnter>
						GameTooltip:SetOwner(self, "ANCHOR_CURSOR")
						GameTooltip:SetText(FPERL_AGGRO_DRAGTIP, 1, 1, 1)
					</OnEnter>
					<OnLeave>
						GameTooltip:Hide()
					</OnLeave>
					<OnDragStart>
						FPerl_AggroAnchor:SetFrameStrata("DIALOG")
						GameTooltip:Hide()
						self.tex:Hide()
						FPerl_AggroPlayer:SetVertexColor(0, 0, 1)
						FPerl_AggroPet:SetVertexColor(0, 0, 1)
						FPerl_AggroPlayer:SetAlpha(1)
						FPerl_AggroPet:SetAlpha(1)
						FPerl_AggroPlayer:Show()
						FPerl_AggroPet:Show()
						FPerl_Aggro:SetScript("OnUpdate", nil)
						FPerl_Aggro:Show()
						FPerl_AggroAnchor:StartMoving()
					</OnDragStart>
					<OnDragStop>
						FPerl_AggroAnchor:SetFrameStrata("MEDIUM")
						self.tex:Show()
						FPerl_Aggro:SetScript("OnUpdate", FPerl.RaidHelper.RefreshAggro)
						FPerl_AggroAnchor:StopMovingOrSizing()

						FPerl_AggroPlayer:Hide()
						FPerl_AggroPet:Hide()
						FPerl_Aggro:Hide()

						if (FPerl.SavePosition) then
							FPerl.SavePosition(FPerl_AggroAnchor)
						end
					</OnDragStop>
				</Scripts>
			</Frame>
		</Frames>
		<Scripts>
			<OnLoad>
				FPerl.SetChildMembers(self)

				self.Enable = function(self)
					self.Arrows:Show()
					self:EnableMouse(true)
					self:SetFrameStrata("MEDIUM")
				end
				self.Disable = function(self)
					self.Arrows:Hide()
					self:EnableMouse(false)
					self:SetFrameStrata("HIGH")
				end

				self:Disable()
			</OnLoad>
		</Scripts>
	</Frame>

	<Frame name="FPerl_Aggro" parent="FPerl_AggroAnchor" inherits="FPerl_BackdropTemplate" hidden="true">
		<Scripts>
			<OnLoad>
				self:SetScript("OnUpdate", FPerl.RaidHelper.RefreshAggro)
			</OnLoad>
			<OnHide>
				self.playerFadeStart = nil
				self.petFadeStart = nil
			</OnHide>
		</Scripts>
		<Size>
			<AbsDimension x="256" y="64"/>
		</Size>
		<Anchors>
			<Anchor point="CENTER"/>
		</Anchors>
		<Layers>
			<Layer level="OVERLAY">
				<FontString name="$parentPlayer" outline="THICK" font="GameFont_Gigantic" justifyH="CENTER" text="FPERL_AGGRO_PLAYER" hidden="true">
					<FontHeight>
						<AbsValue val="42"/>
					</FontHeight>
				</FontString>
				<FontString name="$parentPet" outline="THICK" font="SystemFont_Huge1" justifyH="CENTER" text="FPERL_AGGRO_PET" hidden="true">
					<Anchors>
						<Anchor point="TOP" relativeTo="$parentPlayer" relativePoint="BOTTOM" />
					</Anchors>
					<FontHeight>
						<AbsValue val="16"/>
					</FontHeight>
				</FontString>
			</Layer>
		</Layers>
	</Frame>
</Ui>
