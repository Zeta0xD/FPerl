<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">

	<Script file="localization.lua"/>
	<Script file="FPerl_Config.lua"/>
	<Script file="FPerl_RaidHelper.lua"/>

	<GameTooltip name="FPerl_BottomTip" frameStrata="LOW" parent="UIParent" inherits="GameTooltipTemplate"/>

	<Button name="FPerl_MTList_BasicButton" inherits="FPerl_BackdropTemplate" virtual="true">
		<KeyValues>
			<KeyValue key="backdropInfo" value="FPerl_Raid_Backdrop_16_9_3333" type="global"/>
		</KeyValues>
		<Scripts>
			<OnEnter>
				if (self.tooltipText) then
					GameTooltip:SetOwner(self, "ANCHOR_RIGHT")
					GameTooltip:SetText(self.tooltipText, nil, nil, nil, nil, true)
				end
			</OnEnter>
			<OnLeave>
				GameTooltip:Hide()
			</OnLeave>
		</Scripts>
	</Button>

	<Button name="FPerl_MTList_UnitTemplate" inherits="FPerl_BackdropTemplate,SecureActionButtonTemplate" virtual="true" hidden="true">
		<KeyValues>
			<KeyValue key="backdropInfo" value="FPerl_Raid_Backdrop_16_9_3333" type="global"/>
		</KeyValues>
		<Scripts>
			<OnLoad>
				self:OnBackdropLoaded()
				FPerl.SetChildMembers(self)
				self:RegisterForClicks("AnyUp")
				-- act on up-clicks whatever ActionButtonUseKeyDown says
				self:SetAttribute("useOnKeyDown", false)
				FPerl.RegisterBar(_G[self:GetName().."healthBar"])

				if (not strmatch(self:GetName(), "Targets.+Target")) then
					FPerl.RaidHelper.MTListChildUnits(self)
				end
			</OnLoad>
			<OnEnter>FPerl.RaidHelper.MTListUnitOnEnter(self, motion)</OnEnter>
			<OnLeave>
				GameTooltip:Hide()
				FPerl_BottomTip:Hide()
			</OnLeave>
		</Scripts>
		<Size>
			<AbsDimension x="100" y="26"/>
		</Size>
		<HighlightTexture file="Interface\Addons\FPerl\Images\FPerl_Highlight" alphaMode="ADD">
			<TexCoords left="0" right="1" top="0.5" bottom="1"/>
		</HighlightTexture>
		<Frames>
			<StatusBar name="$parenthealthBar" inherits="FPerl_BackdropTemplate" enableMouse="false">
				<Scripts>
					<OnLoad>
						self.text = _G[self:GetName().."text"]
						self.tex = _G[self:GetName().."tex"]
						self.bg = _G[self:GetName().."bg"]
					</OnLoad>
				</Scripts>
				<Size>
					<AbsDimension x="70" y="10"/>
				</Size>
				<HitRectInsets>
					<AbsInset left="70" right="70" top="10" bottom="10"/>
				</HitRectInsets>
				<Anchors>
					<Anchor point="TOPLEFT">
						<Offset>
							<AbsDimension x="3" y="-14"/>
						</Offset>
					</Anchor>
					<Anchor point="BOTTOMRIGHT">
						<Offset>
							<AbsDimension x="-3" y="2"/>
						</Offset>
					</Anchor>
				</Anchors>
				<BarTexture name="$parenttex" file="Interface\TargetingFrame\UI-StatusBar"/>
				<Layers>
					<Layer level="OVERLAY">
						<FontString name="$parenttext" inherits="GameFontNormalSmall" setAllPoints="true" hidden="tru">
							<Color r="1" g="1" b="1"/>
						</FontString>
					</Layer>
					<Layer level="BACKGROUND">
						<Texture name="$parentbg" file="Interface\TargetingFrame\UI-TargetingFrame-BarFill" setAllPoints="true"/>
					</Layer>
				</Layers>
			</StatusBar>
		</Frames>

		<Layers>
			<Layer level="ARTWORK">
				<!-- Combat Icon -->
				<Texture name="$parentcombatIcon" file="Interface\CharacterFrame\UI-StateIcon" hidden="true">
					<Size>
						<AbsDimension x="24" y="24"/>
					</Size>
					<Anchors>
						<Anchor point="TOPRIGHT">
							<Offset>
								<AbsDimension x="4" y="4"/>
							</Offset>
						</Anchor>
					</Anchors>
					<TexCoords left="0.5" right = "1.0" top="0.0" bottom="0.5"/>
				</Texture>
			</Layer>

			<Layer level="OVERLAY">
				<!-- Raid Target Icon -->
				<Texture name="$parentraidIcon" file="Interface\TargetingFrame\UI-RaidTargetingIcons" hidden="true">
					<Size>
						<AbsDimension x="10" y="10"/>
					</Size>
					<Anchors>
						<Anchor point="CENTER" relativePoint="TOPRIGHT">
							<Offset>
								<AbsDimension x="-4" y="-4"/>
							</Offset>
						</Anchor>
					</Anchors>
					<TexCoords left="0" right="0.25" top="0" bottom="0.25" />
				</Texture>

				<!-- Warning Icon -->
				<Texture name="$parentwarningIcon" file="Interface\Minimap\Ping\ping6" alphaMode="ADD" hidden="true">
					<Size>
						<AbsDimension x="24" y="24"/>
					</Size>
					<Anchors>
						<Anchor point="TOP">
							<Offset>
								<AbsDimension x="0" y="3"/>
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>

				<FontString name="$parenttext" inherits="GameFontNormalSmall" text="-" justifyH="LEFT" justifyV="TOP">
					<FontHeight>
						<AbsValue val="10"/>
					</FontHeight>
					<Anchors>
						<Anchor point="TOPLEFT">
							<Offset>
								<AbsDimension x="2" y="-2"/>
							</Offset>
						</Anchor>
						<Anchor point="BOTTOMRIGHT">
							<Offset>
								<AbsDimension x="-2" y="1"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>

				<FontString name="$parentlabel" inherits="GameFontNormalSmall" hidden="true" justifyH="RIGHT" justifyV="TOP">
					<Size>
						<AbsDimension x="24" y="12"/>
					</Size>
					<Anchors>
						<Anchor point="TOPRIGHT" relativePoint="TOPLEFT" relativeTo="$parenttext">
							<Offset>
								<AbsDimension x="-1" y="0"/>
							</Offset>
						</Anchor>
						<Anchor point="BOTTOMLEFT" relativePoint="BOTTOMLEFT" relativeTo="$parenttext">
							<Offset>
								<AbsDimension x="-20" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
					<Color r="1" g="1" b="1"/>
				</FontString>
			</Layer>
		</Layers>
	</Button>

	<Frame name="FPerl_MTList_Anchor" parent="UIParent" inherits="FPerl_BackdropTemplate" movable="true" resizable="true" clampedToScreen="true">
		<Size>
			<AbsDimension x="206" y="80"/>
		</Size>
	</Frame>

	<Frame name="FPerl_RaidHelperCheck" inherits="FPerl_BackdropTemplate">
		<Scripts>
			<OnUpdate>FPerl.RaidHelper.HelperCheckOnUpdate(self, elapsed)</OnUpdate>
		</Scripts>
	</Frame>

	<Frame name="FPerl_RaidHelper_Frame" parent="FPerl_MTList_Anchor" inherits="FPerl_BackdropTemplate" hidden="true" clampedToScreen="true">
		<KeyValues>
			<KeyValue key="backdropInfo" value="FPerl_Raid_Backdrop_16_9_3333" type="global"/>
		</KeyValues>
		<Size>
			<AbsDimension x="206" y="80"/>
		</Size>
		<Anchors>
			<Anchor point="TOPLEFT" relativeTo="FPerl_MTList_Anchor"/>
		</Anchors>
		<Frames>
			<Frame name="$parent_TitleBar" inherits="FPerl_BackdropTemplate" >
				<Size>
					<AbsDimension x="160" y="12"/>
				</Size>
				<Anchors>
					<Anchor point="TOPLEFT">
						<Offset>
							<AbsDimension x="3" y="-3"/>
						</Offset>
					</Anchor>
					<Anchor point="BOTTOMRIGHT" relativePoint="TOPRIGHT">
						<Offset>
							<AbsDimension x="-3" y="-13"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Frames>
					<Button name="$parent_CloseButton" inherits="UIPanelCloseButton">
						<Size>
							<AbsDimension x="20" y="20"/>
						</Size>
						<Anchors>
							<Anchor point="TOPRIGHT">
								<Offset>
									<AbsDimension x="5" y="5"/>
								</Offset>
							</Anchor>
						</Anchors>
						<Scripts>
							<OnClick>
								FPerlRaidHelperDB.RaidHelper = 0
								FPerl.RaidHelper.EnableDisable()
							</OnClick>
						</Scripts>
					</Button>

					<Button name="$parent_Pin" inherits="FPerl_MTList_BasicButton">
						<Size>
							<AbsDimension x="11" y="11"/>
						</Size>
						<Anchors>
							<Anchor point="RIGHT" relativeTo="$parent_CloseButton" relativePoint="LEFT">
								<Offset>
									<AbsDimension x="4" y="0"/>
								</Offset>
							</Anchor>
						</Anchors>
						<NormalTexture file="Interface\Addons\FPerl_RaidHelper\Images\FPerl_Pin">
							<TexCoords left="0" right="0.46875" top="0" bottom="0.453125"/>
						</NormalTexture>

						<PushedTexture file="Interface\Addons\FPerl_RaidHelper\Images\FPerl_Pin">
							<TexCoords left="0" right="0.46875" top="0.5" bottom="0.953125"/>
						</PushedTexture>

						<HighlightTexture file="Interface\Buttons\UI-Panel-MinimizeButton-Highlight" alphaMode="ADD">
							<TexCoords left="0" right="0.9" top="0.1" bottom="0.9"/>
						</HighlightTexture>

						<Scripts>
							<OnLoad>
								self.SetButtonTex = function()
									local tex = FPerl_RaidHelper_Frame_TitleBar_Pin:GetNormalTexture()
									if (FPerlRaidHelperDB.Pinned) then
										tex:SetTexCoord(0.5, 0.96875, 0, 0.453125)
									else
										tex:SetTexCoord(0, 0.46875, 0, 0.453125)
									end

									tex = FPerl_RaidHelper_Frame_TitleBar_Pin:GetPushedTexture()
									if (FPerlRaidHelperDB.Pinned) then
										if (FPerl_RaidHelper_Frame.corner) then
											FPerl_RaidHelper_Frame.corner:Hide()
										end
										tex:SetTexCoord(0.5, 0.96875, 0.5, 0.953125)
									else
										if (FPerl_RaidHelper_Frame.corner) then
											FPerl_RaidHelper_Frame.corner:Show()
										end
										tex:SetTexCoord(0, 0.46875, 0.5, 0.953125)
									end
								end
								self.tooltipText = FPERL_BUTTON_HELPER_PIN
							</OnLoad>
							<OnClick>
								FPerlRaidHelperDB.Pinned = not FPerlRaidHelperDB.Pinned
								self:SetButtonTex()
							</OnClick>
						</Scripts>
					</Button>

					<Button name="$parent_ToggleLabels" inherits="FPerl_MTList_BasicButton">
						<Size>
							<AbsDimension x="11" y="11"/>
						</Size>
						<Anchors>
							<Anchor point="RIGHT" relativeTo="$parent_Pin" relativePoint="LEFT"/>
							<!--Anchor point="RIGHT" relativeTo="FPerl_Frame_ExpandLock" relativePoint="LEFT"/-->
						</Anchors>
						<NormalTexture file="Interface\Addons\FPerl_RaidHelper\Images\FPerl_Bits">
							<TexCoords left="0.5" right="0.625" top="0.0" bottom="0.125"/>
						</NormalTexture>

						<PushedTexture file="Interface\Addons\FPerl_RaidHelper\Images\FPerl_Bits">
							<TexCoords left="0.5" right="0.625" top="0.125" bottom="0.25"/>
						</PushedTexture>

						<DisabledTexture file="Interface\Addons\FPerl_RaidHelper\Images\FPerl_Bits">
							<TexCoords left="0.5" right="0.625" top="0.25" bottom="0.375"/>
						</DisabledTexture>

						<HighlightTexture file="Interface\Buttons\UI-Panel-MinimizeButton-Highlight" alphaMode="ADD">
							<TexCoords left="0" right="0.9" top="0.1" bottom="0.9"/>
						</HighlightTexture>

						<Scripts>
							<OnLoad>
								self.tooltipText = FPERL_BUTTON_TOGGLE_LABELS
								self.SetButtonTex = function(self)
									local tex = self:GetNormalTexture()
									if (FPerlRaidHelperDB.MTLabels == 1) then
										tex:SetTexCoord(0.5, 0.625, 0.125, 0.25)
									else
										tex:SetTexCoord(0.5, 0.625, 0, 0.125)
									end

									tex = self:GetDisabledTexture()
									if (FPerlRaidHelperDB.MTLabels == 1) then
										tex:SetTexCoord(0.5, 0.625, 0.375, 0.5)
									else
										tex:SetTexCoord(0.5, 0.625, 0.25, 0.375)
									end
								end
							</OnLoad>
							<OnClick>FPerl.RaidHelper.ToggleLabels(self, button, down)</OnClick>
						</Scripts>
					</Button>

					<Button name="$parent_ToggleMTTargets" inherits="FPerl_MTList_BasicButton">
						<Size>
							<AbsDimension x="11" y="11"/>
						</Size>
						<Anchors>
							<Anchor point="RIGHT" relativeTo="$parent_ToggleLabels" relativePoint="LEFT"/>
							<!--Anchor point="RIGHT" relativeTo="FPerl_Frame_ToggleTargets" relativePoint="LEFT"/-->
						</Anchors>
						<NormalTexture file="Interface\Addons\FPerl_RaidHelper\Images\FPerl_Bits">
							<TexCoords left="0.625" right="0.75" top="0.0" bottom="0.125"/>
						</NormalTexture>

						<PushedTexture file="Interface\Addons\FPerl_RaidHelper\Images\FPerl_Bits">
							<TexCoords left="0.625" right="0.75" top="0.125" bottom="0.25"/>
						</PushedTexture>

						<DisabledTexture file="Interface\Addons\FPerl_RaidHelper\Images\FPerl_Bits">
							<TexCoords left="0.625" right="0.75" top="0.25" bottom="0.375"/>
						</DisabledTexture>

						<HighlightTexture file="Interface\Buttons\UI-Panel-MinimizeButton-Highlight" alphaMode="ADD">
							<TexCoords left="0" right="0.9" top="0.1" bottom="0.9"/>
						</HighlightTexture>

						<Scripts>
							<OnLoad>
								self.tooltipText = FPERL_BUTTON_TOGGLE_MTTARGETS
								self.SetButtonTex = function(self)
									local tex = self:GetNormalTexture()

									if (FPerlRaidHelperDB.MTTargetTargets == 1) then
										tex:SetTexCoord(0.625, 0.75, 0.125, 0.25)
									else
										tex:SetTexCoord(0.625, 0.75, 0, 0.125)
									end

									tex = self:GetDisabledTexture()
									if (FPerlRaidHelperDB.MTTargetTargets == 1) then
										tex:SetTexCoord(0.625, 0.75, 0.375, 0.5)
									else
										tex:SetTexCoord(0.625, 0.75, 0.25, 0.375)
									end
								end
							</OnLoad>
							<OnClick>FPerl.RaidHelper.ToggleMTTargets(self, button, down)</OnClick>
						</Scripts>
					</Button>

					<Button name="$parent_ToggleShowMT" inherits="FPerl_MTList_BasicButton">
						<Size>
							<AbsDimension x="11" y="11"/>
						</Size>
						<Anchors>
							<Anchor point="RIGHT" relativeTo="$parent_ToggleMTTargets" relativePoint="LEFT"/>
						</Anchors>
						<NormalTexture file="Interface\Addons\FPerl_RaidHelper\Images\FPerl_Bits">
							<TexCoords left="0.75" right="0.875" top="0.0" bottom="0.125"/>
						</NormalTexture>

						<PushedTexture file="Interface\Addons\FPerl_RaidHelper\Images\FPerl_Bits">
							<TexCoords left="0.75" right="0.875" top="0.125" bottom="0.25"/>
						</PushedTexture>

						<DisabledTexture file="Interface\Addons\FPerl_RaidHelper\Images\FPerl_Bits">
							<TexCoords left="0.75" right="0.875" top="0.25" bottom="0.375"/>
						</DisabledTexture>

						<HighlightTexture file="Interface\Buttons\UI-Panel-MinimizeButton-Highlight" alphaMode="ADD">
							<TexCoords left="0" right="0.9" top="0.1" bottom="0.9"/>
						</HighlightTexture>

						<Scripts>
							<OnLoad>
								self.tooltipText = FPERL_BUTTON_TOGGLE_SHOWMT
								self.SetButtonTex = function(self)
									local tex = self:GetNormalTexture()

									if (FPerlRaidHelperDB.ShowMT == 1) then
										tex:SetTexCoord(0.75, 0.875, 0.125, 0.25)
									else
										tex:SetTexCoord(0.75, 0.875, 0, 0.125)
									end

									tex = self:GetDisabledTexture()
									if (FPerlRaidHelperDB.ShowMT == 1) then
										tex:SetTexCoord(0.75, 0.875, 0.375, 0.5)
									else
										tex:SetTexCoord(0.75, 0.875, 0.25, 0.375)
									end
								end
							</OnLoad>
							<OnClick>FPerl.RaidHelper.ToggleShowMT(self, button, down)</OnClick>
						</Scripts>
					</Button>
				</Frames>
				<Layers>
					<Layer level="ARTWORK">
						<FontString name="FPerl_Frame_Title" inherits="GameFontNormalSmall" text="MT Targets" justifyH="LEFT">
							<Color r="1" g="1" b="1"/>
							<Anchors>
								<Anchor point="TOPLEFT">
									<Offset>
										<AbsDimension x="10" y="0"/>
									</Offset>
								</Anchor>
								<Anchor point="BOTTOMRIGHT"/>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
			</Frame>

			<Frame name="FPerl_MTTargets" inherits="FPerl_BackdropTemplate,SecureRaidGroupHeaderTemplate">
				<Size>
					<AbsDimension x="160" y="26"/>
				</Size>
				<Anchors>
					<Anchor point="TOPLEFT">
						<Offset>
							<AbsDimension x="3" y="-13"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Attributes>
					<Attribute name="template" type="string" value="FPerl_MTList_UnitTemplate"/>
				</Attributes>
				<Layers>
					<Layer level="OVERLAY">
						<Texture name="FPerl_MainAssist" file="Interface\GroupFrame\UI-Group-MainAssistIcon" hidden="true">
							<Size>
								<AbsDimension x="12" y="12"/>
							</Size>
							<Anchors>
								<Anchor point="RIGHT" relativePoint="LEFT">
									<Offset>
										<AbsDimension x="-100" y="0"/>
									</Offset>
								</Anchor>
							</Anchors>
						</Texture>
						<Texture name="FPerl_MainTank" file="Interface\GroupFrame\UI-Group-MainTankIcon" hidden="true">
							<Size>
								<AbsDimension x="12" y="12"/>
							</Size>
							<Anchors>
								<Anchor point="RIGHT" relativePoint="LEFT">
									<Offset>
										<AbsDimension x="-100" y="0"/>
									</Offset>
								</Anchor>
							</Anchors>
						</Texture>

						<Texture name="FPerl_MyTarget" file="Interface\Minimap\Ping\ping5" hidden="true" alphaMode="ADD">
							<Size>
								<AbsDimension x="16" y="12"/>
							</Size>
							<Anchors>
								<Anchor point="RIGHT" relativePoint="LEFT">
									<Offset>
										<AbsDimension x="-100" y="0"/>
									</Offset>
								</Anchor>
							</Anchors>
							<TexCoords left="0" right="0.23" top="0.35" bottom="0.65"/>
						</Texture>
					</Layer>
				</Layers>
			</Frame>
		</Frames>
		<Scripts>
			<OnLoad>FPerl.RaidHelper.OnLoad(self)</OnLoad>
			<OnEvent>FPerl.RaidHelper.OnEvent(self, event, ...)</OnEvent>
			<OnDragStart>
				if (not FPerlRaidHelperDB or not FPerlRaidHelperDB.Pinned or (IsAltKeyDown() and IsControlKeyDown() and IsShiftKeyDown())) then
					FPerl_MTList_Anchor:StartMoving()
				end
			</OnDragStart>
			<OnDragStop>
				FPerl_MTList_Anchor:StopMovingOrSizing()
				if (FPerl.SavePosition) then
					FPerl.SavePosition(FPerl_MTList_Anchor)
				end
			</OnDragStop>
		</Scripts>
	</Frame>
</Ui>
