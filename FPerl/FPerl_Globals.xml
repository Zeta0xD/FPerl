	<Frame name="FPerl_HighlightTemplate" inherits="FPerl_BackdropTemplate" virtual="true">
		<Scripts>
			<OnLoad>
				FPerl.SetChildMembers(self)

				local p = self:GetParent()
				local f = _G[p:GetName().."statsFrame"]
				if (f) then
					self:SetFrameLevel(f:GetFrameLevel() + 1)
				end

				p.highlight = self

				if (not p:GetScript("OnEnter")) then
					p:SetScript("OnEnter", function(self)
						if (self.highlight) then
							self.highlight:Select()
						end
						FPerl.PlayerTip(self)
					end)
				end
				if (not p:GetScript("OnLeave")) then
					p:SetScript("OnLeave", function(self)
						if (self.highlight) then
							self.highlight:Deselect()
						end
						FPerl.PlayerTipHide()
					end)
				end

				self.Select = function(self)
					if (FPerl.layout.highlightSelection) then
						self.sel = true
						self.tex:Show()
						if (FPerl_Highlight and FPerl_Highlight.SetHighlight) then
							FPerl_Highlight:SetHighlight(self:GetParent())
						end
					end
				end

				self.Deselect = function(self)
					if (FPerl.layout.highlightSelection) then
						self.sel = nil
						self.tex:Hide()
						if (FPerl_Highlight and FPerl_Highlight.SetHighlight) then
							FPerl_Highlight:SetHighlight(self:GetParent())
						end
					end
				end
			</OnLoad>
		</Scripts>
		<Layers>
			<Layer level="OVERLAY">
				<Texture name="$parenttex" hidden="true" file="Interface\Addons\FPerl\Images\FPerl_Highlight" alphaMode="ADD">
					<TexCoords left="0.25" right="0.75" top="0" bottom="0.5"/>
				</Texture>
			</Layer>
		</Layers>
	</Frame>

